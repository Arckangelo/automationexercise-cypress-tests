{
  "name": "automationexercise-tests",
  "version": "1.0.0",
  "description": "Testes E2E e de API do AutomationExercise com Cypress, incluindo testes de regressão para bugs conhecidos do site",
  "private": true,
  "scripts": {
    "test": "node scripts/cypress.js run",
    "test:chrome": "node scripts/cypress.js run --browser chrome",
    "test:firefox": "node scripts/cypress.js run --browser firefox",
    "test:edge": "node scripts/cypress.js run --browser edge",
    "test:open": "node scripts/cypress.js open",
    "test:headed": "node scripts/cypress.js run --headed",
    "test:smoke": "node scripts/cypress.js run --browser chrome --expose grepTags=@smoke",
    "test:smoke:mobile": "node scripts/cypress.js run --browser chrome --env mobile=true --expose grepTags=@smoke",
    "test:mobile": "node scripts/cypress.js run --browser chrome --env mobile=true",
    "test:mutation": "node scripts/mutation-run.js",
    "test:bugs": "node scripts/cypress.js run --env knownBugs=true --spec \"cypress/e2e/known-bugs/**\"",
    "test:bugs:pr": "node scripts/cypress.js run --env knownBugs=true --spec \"cypress/e2e/known-bugs/**\" --expose grepTags=-@creates-order",
    "test:bugs:open": "node scripts/cypress.js open --e2e --env knownBugs=true",
    "format": "prettier --write \"cypress/**/*.{js,json}\" \"scripts/*.js\" cypress.config.js",
    "format:check": "prettier --check \"cypress/**/*.{js,json}\" \"scripts/*.js\" cypress.config.js",
    "check:tags": "node scripts/check-tags.js",
    "check:orders": "node scripts/check-order-tags.js"
  },
  "keywords": [
    "cypress",
    "e2e",
    "api-testing",
    "qa",
    "automation"
  ],
  "author": "Angelo Roque (https://github.com/Arckangelo)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Arckangelo/automationexercise-cypress-tests.git"
  },
  "license": "ISC",
  "type": "commonjs",
  "devDependencies": {
    "@babel/parser": "8.1.0",
    "@cypress/grep": "7.0.0",
    "cypress": "^16.2.1",
    "cypress-mochawesome-reporter": "^5.0.0",
    "prettier": "3.9.10"
  },
  "engines": {
    "node": ">=24"
  },
  "allowScripts": {
    "cypress": true
  }
}
