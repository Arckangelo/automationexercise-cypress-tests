{
  "name": "automationexercise-tests",
  "version": "1.0.0",
  "description": "Projeto de automação de testes com Cypress",
  "main": "index.js",
  "scripts": {
    "test": "cypress run",
    "test:open": "cypress open",
    "test:headed": "cypress run --headed",
    "test:bugs": "cypress run --env knownBugs=true --spec \"cypress/e2e/known-bugs/**\"",
    "test:bugs:open": "cypress open --e2e --env knownBugs=true"
  },
  "keywords": ["cypress", "automation", "tests"],
  "author": "",
  "license": "ISC",
  "type": "commonjs",
  "devDependencies": {
    "cypress": "^14.0.0"
  }
}
