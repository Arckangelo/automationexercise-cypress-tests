{
  "name": "automationexercise-tests",
  "version": "1.0.0",
  "description": "Testes E2E e de API do AutomationExercise com Cypress, incluindo testes de regressão para bugs conhecidos do site",
  "private": true,
  "scripts": {
    "test": "cypress run",
    "test:open": "cypress open",
    "test:headed": "cypress run --headed",
    "test:bugs": "cypress run --env knownBugs=true --spec \"cypress/e2e/known-bugs/**\"",
    "test:bugs:open": "cypress open --e2e --env knownBugs=true"
  },
  "keywords": ["cypress", "e2e", "api-testing", "qa", "automation"],
  "author": "Angelo Roque (https://github.com/Arckangelo)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Arckangelo/automationexercise-cypress-tests.git"
  },
  "license": "ISC",
  "type": "commonjs",
  "devDependencies": {
    "cypress": "^16.2.0",
    "cypress-mochawesome-reporter": "^5.0.0"
  }
}
